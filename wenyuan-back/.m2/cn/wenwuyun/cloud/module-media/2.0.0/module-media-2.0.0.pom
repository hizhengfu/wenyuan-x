      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-codec</artifactId>
      <version>4.1.70.Final</version>
      <scope>runtime</scope>
      <exclusions>
        <exclusion>
          <groupId>com.h2database</groupId>
