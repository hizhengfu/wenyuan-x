      <artifactId>ffmpeg</artifactId>
      <version>6.0-1.5.9</version>
      <classifier>windows-x86_64</classifier>
      <scope>runtime</scope>
      <exclusions>
        <exclusion>
          <groupId>com.h2database</groupId>
          <artifactId>h2</artifactId>
