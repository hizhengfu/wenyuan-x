{
  "key": "collection_transfer",
  "name": "藏品跨馆调拨审批",
  "category": "collection",
  "description": "调拨申请 → 保管部主任初审 → 分管馆长审批 → 过户。跨法人单位调拨可在设计器中追加目标馆会签/上级文物部门审批。",
  "model": {
    "nodes": [
      { "id": "start_1", "type": "bpmn:startEvent", "x": 100, "y": 200,
        "properties": { "nodeKey": "start", "name": "发起调拨", "nodeType": "START" } },
      { "id": "review_1", "type": "bpmn:userTask", "x": 300, "y": 200,
        "properties": { "nodeKey": "review", "name": "保管部初审", "nodeType": "APPROVE",
          "assigneeType": "ROLE", "assignees": ["COLLECTION_STORAGE_HEAD"], "rejectType": "TERMINATE",
          "actions": ["APPROVE", "REJECT"], "fieldPerms": [{ "field": "*", "perm": "READONLY" }] } },
      { "id": "approve_1", "type": "bpmn:userTask", "x": 500, "y": 200,
        "properties": { "nodeKey": "approve", "name": "分管馆长审批", "nodeType": "APPROVE",
          "assigneeType": "ROLE", "assignees": ["COLLECTION_VICE_DIRECTOR"], "rejectType": "TERMINATE",
          "actions": ["APPROVE", "REJECT"], "fieldPerms": [{ "field": "*", "perm": "READONLY" }] } },
      { "id": "end_1", "type": "bpmn:endEvent", "x": 700, "y": 200,
        "properties": { "nodeKey": "end", "name": "调拨完成", "nodeType": "END" } }
    ],
    "edges": [
      { "id": "e1", "sourceNodeId": "start_1", "targetNodeId": "review_1", "properties": {} },
      { "id": "e2", "sourceNodeId": "review_1", "targetNodeId": "approve_1", "properties": {} },
      { "id": "e3", "sourceNodeId": "approve_1", "targetNodeId": "end_1", "properties": {} }
    ]
  }
}
